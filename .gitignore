# ambiente
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# artefatos de execucao (video/audio/clipes sao grandes)
out/
_teste/

# resposta colada do modelo no modo manual: e entrada de UM video,
# fica na raiz e seria sobrescrita pelo proximo. Vive junto do out/.
resposta*.json

# EXCECAO (CLIP-F6 / Emenda 2): provas/fixtures/ e curado por definicao --
# nada entra ali por acidente. A excecao e AMPLA de proposito: uma excecao
# estreita desarma um padrao so, e o proximo artefato de prova que casar com
# out/, _teste/ ou models/ seria engolido em silencio de novo. 'git add' nao
# reporta erro para caminho ignorado, entao o buraco so apareceria na proxima
# maquina, com a prova falhando sem motivo aparente.
!provas/fixtures/**

# nunca versionar segredos
.env
*.key

# modelos baixados
models/
